#!/usr/bin/env ruby
# frozen_string_literal: true

# realpath, not __dir__: the CLI runs through a ~/.local/bin/railway symlink.
ROOT = File.expand_path("..", File.dirname(File.realpath(__FILE__)))
$LOAD_PATH.unshift File.join(ROOT, "lib")

require "optparse"
require "railway_cli/version"
require "railway_cli/env"
require "railway_cli/auth"
require "railway_cli/formatter"
require "railway_cli/client"
require "railway_cli/resolver"
require "railway_cli/dashboard"
require "railway_cli/commands/whoami"
%w[context projects project environments services status deployments domains volumes rate logs variables deploy domain environment project_write gql].each do |c|
  require "railway_cli/commands/#{c}"
end

# Read commands: name => [module, one-line help]. Each module runs with a Commands::Context.
COMMANDS = {
  "projects" => [RailwayCli::Commands::Projects, "list projects visible to the token"],
  "project" => [RailwayCli::Commands::Project, "environments, services, last deploy status [--project]"],
  "environments" => [RailwayCli::Commands::Environments, "list environments --project"],
  "services" => [RailwayCli::Commands::Services, "list services --project [--env]"],
  "status" => [RailwayCli::Commands::Status, "per-service deploy status [--project] [--env]"],
  "deployments" => [RailwayCli::Commands::Deployments, "recent deployments --project --env --service [-n 10]"],
  "domains" => [RailwayCli::Commands::Domains, "service and custom domains --project --env [--service]"],
  "volumes" => [RailwayCli::Commands::Volumes, "volumes and backups --project"],
  "rate" => [RailwayCli::Commands::Rate, "last known rate-limit headers"],
  "logs" => [RailwayCli::Commands::Logs, "--project --env --service [--build] [--deployment ID] [-n 200] [--filter Q] [-f] [--interval 3]"],
  "vars" => [RailwayCli::Commands::Variables,
             "[--reveal] | vars diff --env A --env2 B | vars set KEY=VALUE|KEY=- [--skip-deploys] | vars delete KEY [--confirm KEY]"],
  "redeploy" => [RailwayCli::Commands::DeploymentAction.for("redeploy"), "redeploy --deployment ID, or latest for --service"],
  "restart" => [RailwayCli::Commands::DeploymentAction.for("restart"), "restart --deployment ID, or latest for --service"],
  "rollback" => [RailwayCli::Commands::DeploymentAction.for("rollback"), "roll back to --deployment ID, or latest for --service"],
  "stop" => [RailwayCli::Commands::DeploymentAction.for("stop"), "stop --deployment ID, or latest for --service"],
  "cancel" => [RailwayCli::Commands::DeploymentAction.for("cancel"), "cancel --deployment ID, or latest for --service"],
  "deploy" => [RailwayCli::Commands::Deploy, "deploy --service S | deploy --env E --all"],
  "domain" => [RailwayCli::Commands::Domain, "domain create --service S [--custom HOST] | domain delete HOST --env E [--confirm HOST]"],
  "env" => [RailwayCli::Commands::Environment, "env create NAME --project P [--from E] | env delete NAME --project P [--confirm NAME]"],
  "gql" => [RailwayCli::Commands::Gql, "[-f FILE | QUERY] [--vars JSON] [--write] [--confirm OPNAME]"]
}.freeze

# Subcommands routed away from a read command of the same name.
SUBCOMMANDS = {
  %w[project create] => [RailwayCli::Commands::ProjectWrite, "project create NAME [--workspace W]"],
  %w[project delete] => [RailwayCli::Commands::ProjectWrite, "project delete NAME [--confirm NAME]"]
}.freeze

# Mutating commands as "command subcommand"; later phases add to this.
WRITE_COMMANDS = ["vars set", "redeploy", "restart", "rollback", "stop", "cancel", "deploy",
                  "domain create", "env create", "project create",
                  "vars delete", "domain delete", "env delete", "project delete"].freeze

HELP = <<~TEXT
  usage: railway [global options] <command> [options]

  Personal Railway CLI on the public GraphQL API.

  Global options:
    -j, --json          JSON output
    --project-token     use the project token (RAILWAY_PAT_PROJECT)
    --project NAME|ID   --env NAME|ID   --service NAME|ID
    -n, --limit N       max rows for list commands

  Commands:
    whoami        report each token's type and identity
    #{COMMANDS.map { |n, (_, h)| format("%-13s %s", n, h) }.join("\n  ")}
    #{SUBCOMMANDS.map { |n, (_, h)| format("%-13s %s", n.first, h) }.join("\n  ")}
    --version   print version
    help        show this help
TEXT

RailwayCli::Env.load(File.join(ROOT, ".env"))
RailwayCli::Auth.register_tokens(ENV)

opts = { json: false, project_token: false }
args = ARGV.dup
parser = OptionParser.new do |o|
  o.on("-j", "--json") { opts[:json] = true }
  o.on("--project-token") { opts[:project_token] = true }
  o.on("--project ID") { |v| opts[:project] = v }
  o.on("--env ID") { |v| opts[:env] = v }
  o.on("--service ID") { |v| opts[:service] = v }
  o.on("-n", "--limit N", Integer) { |v| opts[:limit] = v }
  o.on("--build") { opts[:build] = true }
  o.on("--deployment ID") { |v| opts[:deployment] = v }
  o.on("--filter Q") { |v| opts[:filter] = v }
  o.on("-f", "--follow") { opts[:follow] = true }
  o.on("--interval SECONDS", Float) { |v| opts[:interval] = v }
  o.on("--env2 ID") { |v| opts[:env2] = v }
  o.on("--reveal") { opts[:reveal] = true }
  o.on("--skip-deploys") { opts[:skip_deploys] = true }
  o.on("--all") { opts[:all] = true }
  o.on("--custom HOST") { |v| opts[:custom] = v }
  o.on("--from ENV") { |v| opts[:from] = v }
  o.on("--workspace W") { |v| opts[:workspace] = v }
  o.on("--confirm NAME") { |v| opts[:confirm] = v }
  o.on("--vars JSON") { |v| opts[:vars] = v }
  o.on("--file FILE") { |v| opts[:file] = v }
  o.on("--write") { opts[:write] = true }
  o.on("-v", "--version") { opts[:version] = true }
  o.on("-h", "--help") { opts[:help] = true }
end
begin
  parser.order!(args)
  command = args.shift
  parser.permute!(args)
rescue OptionParser::ParseError => e
  warn e.message
  warn HELP
  exit 2
end

# gql writes are write commands, but their target is unknown, so no dashboard link.
if command == "gql" && opts[:write]
  opts[:dashboard_url] = nil
end
write_commands = command == "gql" && opts[:write] ? WRITE_COMMANDS + ["gql"] : WRITE_COMMANDS
command = "version" if opts[:version]
command = "help" if opts[:help]

begin
  status =
    case command
    when "version"
      puts "railway-pat-cli #{RailwayCli::VERSION}"
      0
    when nil, "help"
      puts HELP
      0
    when "whoami"
      RailwayCli::Commands::Whoami.run(ENV, json: opts[:json])
    when *COMMANDS.keys
      client = RailwayCli::Client.new(credential: RailwayCli::Auth.pick(ENV, project_token: opts[:project_token]))
      ctx = RailwayCli::Commands::Context.new(client: client, resolver: RailwayCli::Resolver.new(client, opts),
                                              opts: opts, args: args, out: $stdout)
      handler = (SUBCOMMANDS[[command, args.first]] || COMMANDS.fetch(command)).first
      result = handler.respond_to?(:run) ? handler.run(ctx) : handler.call(ctx)
      write_key = write_commands.include?(command) ? command : [command, args.first].compact.join(" ")
      if result.zero? && write_commands.include?(write_key)
        url = opts.key?(:dashboard_url) ? opts[:dashboard_url] : begin
          r = ctx.resolver
          svc = r.service(required: false)
          RailwayCli::Dashboard.url(r.project["id"], r.environment(required: false)&.fetch("id"), svc && svc["id"])
        rescue RailwayCli::UsageError
          nil # e.g. --deployment ID with no --project: the write succeeded, there is just no link
        end
        (opts[:json] ? $stderr : $stdout).puts "dashboard: #{url}" if url
      end
      result
    else
      warn "unknown command: #{command}"
      warn HELP
      2
    end
  exit status
rescue RailwayCli::Error => e
  if opts[:json]
    puts RailwayCli::Formatter.error_envelope(e)
  else
    warn "error: #{e.message}"
  end
  exit RailwayCli.exit_code(e)
end
